desc:Green Stripe 76 Mono
author:Green Stripe 76 contributors
version:0.5.1
tags:dynamics compressor limiter fet
// SPDX-License-Identifier: MIT
options:maxmem=8192 prealloc=8192 gfx_hz=30
import GreenStripe76-Core.jsfx-inc
import GreenStripe76-Presets.jsfx-inc
import GreenStripe76-UI.jsfx-inc
slider1:0<-36,24,0.1>Input (dB)
slider2:0<-36,24,0.1>Output (dB)
slider3:3<1,7,0.01>Attack
slider4:5<1,7,0.01>Release
slider5:1<0,5,1{2:1,4:1,8:1,12:1,20:1,All Buttons}>Ratio
slider6:100<0,100,0.1>Mix (%)
slider7:100<0,100,0.1>Colour (%)
slider8:1<0,1,1{COMP OFF,COMP ON}>Compression
slider9:1<0,1,1{Off,On}>Enabled
slider10:1<0,1,1{Off,On}>-Stereo Link
slider12:0<0,2,1{Off,2x,4x}>Oversampling
slider13:0<0,4,1{None,60s,80s,00s,Symmetric}>Transformer
slider11:0<0,38,1{Custom,01 Neutral Start,02 Dr Pepper Inspired,03 Vocal Natural,04 Vocal Peak Catch,05 Vocal Rock Forward,06 Vocal Grit Parallel,07 Vocal Squashed,08 Vocal Transformer,09 Guitar Clean Sustain,10 Guitar Rhythm Tight,11 Guitar Colour Only,12 Vintage Blue Grit,13 Guitar Cruncher,14 Acoustic Strum,15 Acoustic Finger,16 Bass Finger Level,17 Bass Pick Punch,18 Bass Fast Grit,19 Bass Mojo Bite,20 Huge Sub Weight,21 Kick Weight,22 Snare Crack,23 Snare Slow Attack,24 Snare Saturated Parallel,25 Toms Body,26 Overheads Gentle,27 Room All Buttons,28 Drum Room Smasher,29 Drum Parallel Crush,30 Percussion Snap,31 Piano Gentle,32 Rhodes Body,33 Synth Bass Control,34 Synth Lead Sustain,35 Stereo Bus Subtle,36 Mix Bus Light Glue,37 Piano Gentle 2:1,38 Stereo Bus Subtle 2:1}>Instrument preset
in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R

@init
ext_nodenorm=1; ext_tail_size=-1; ext_gr_meter=0;
gfx_ext_retina=1;
gs_stereo=0;
#gs_ver="0.5.1";
gs_engine.gs_reset(gs_stereo); gs_rate=srate;
gs_inL.gs_meter_init(); gs_inR.gs_meter_init();
gs_outL.gs_meter_init(); gs_outR.gs_meter_init();
gs_grL=gs_grR=gs_peakGR=0; gs_last_preset=slider11; gs_have_controls=0;
gs_meter_decay=exp(-1/(0.35*max(8000,srate)));
gs_meter_rms=1-exp(-1/(0.3*max(8000,srate)));

@slider
slider11!=gs_last_preset ? (slider11>0 ? gs_apply_preset(slider11); gs_last_preset=slider11;) : (
  gs_have_controls && (slider1!=gs_prev1 || slider2!=gs_prev2 || slider3!=gs_prev3 || slider4!=gs_prev4 || slider5!=gs_prev5 || slider6!=gs_prev6 || slider7!=gs_prev7 || slider8!=gs_prev8 || slider9!=gs_prev9 || slider10!=gs_prev10 || slider12!=gs_prev12 || slider13!=gs_prev13) ? (
    slider11=0; gs_last_preset=0; sliderchange(slider11);
  );
);
gs_prev1=slider1; gs_prev2=slider2; gs_prev3=slider3; gs_prev4=slider4; gs_prev5=slider5; gs_prev6=slider6; gs_prev7=slider7; gs_prev8=slider8; gs_prev9=slider9; gs_prev10=slider10; gs_prev12=slider12; gs_prev13=slider13; gs_have_controls=1;
gs_engine.gs_set(slider1,slider2,slider3,slider4,slider5,slider6,slider7,slider8,slider9,slider10,slider12,slider13);

@block
srate!=gs_rate ? (
  gs_engine.gs_reset(gs_stereo); gs_rate=srate;
  gs_meter_decay=exp(-1/(0.35*max(8000,srate)));
  gs_meter_rms=1-exp(-1/(0.3*max(8000,srate)));
);
gs_engine.gs_set(slider1,slider2,slider3,slider4,slider5,slider6,slider7,slider8,slider9,slider10,slider12,slider13);
pdc_delay=gs_engine.gs_latency(); pdc_bot_ch=0; pdc_top_ch=2;
atomic_set(gs_ui_os_active,gs_engine.os_active);
ext_gr_meter=gs_peakGR; gs_peakGR=0;
atomic_set(gs_audio_time,time_precise());
atomic_set(gs_ui_inL,gs_gain_db(gs_inL.peak)); atomic_set(gs_ui_inR,gs_gain_db(gs_stereo ? gs_inR.peak : gs_inL.peak));
atomic_set(gs_ui_outL,gs_gain_db(gs_outL.peak)); atomic_set(gs_ui_outR,gs_gain_db(gs_stereo ? gs_outR.peak : gs_outL.peak));
atomic_set(gs_ui_inRmsL,gs_gain_db(sqrt(max(0,gs_inL.rms))));
atomic_set(gs_ui_inRmsR,gs_gain_db(sqrt(max(0,gs_stereo ? gs_inR.rms : gs_inL.rms))));
atomic_set(gs_ui_rmsL,gs_gain_db(sqrt(max(0,gs_outL.rms))));
atomic_set(gs_ui_rmsR,gs_gain_db(sqrt(max(0,gs_stereo ? gs_outR.rms : gs_outL.rms))));
atomic_set(gs_ui_holdL,gs_gain_db(gs_outL.hold)); atomic_set(gs_ui_holdR,gs_gain_db(gs_stereo ? gs_outR.hold : gs_outL.hold));
atomic_set(gs_ui_inHoldL,gs_gain_db(gs_inL.hold)); atomic_set(gs_ui_inHoldR,gs_gain_db(gs_stereo ? gs_inR.hold : gs_inL.hold));
atomic_set(gs_ui_inClipL,gs_inL.clip); atomic_set(gs_ui_inClipR,gs_stereo ? gs_inR.clip : gs_inL.clip);
atomic_set(gs_ui_grL,gs_grL); atomic_set(gs_ui_grR,gs_grR);
atomic_set(gs_ui_clipL,gs_outL.clip); atomic_set(gs_ui_clipR,gs_stereo ? gs_outR.clip : gs_outL.clip);

@sample
gs_rawL=gs_bound(gs_finite(spl0,0),-256,256);
gs_rawR=gs_bound(gs_finite(spl1,0),-256,256);
gs_stereo ? gs_engine.gs_process(gs_rawL,gs_rawR) : gs_engine.gs_process(gs_rawL,gs_rawL);
spl0=gs_engine.outL; spl1=gs_engine.outR;
gs_inL.gs_meter_sample(gs_rawL); gs_outL.gs_meter_sample(spl0);
gs_stereo ? (gs_inR.gs_meter_sample(gs_rawR); gs_outR.gs_meter_sample(spl1););
gs_peakGR=min(gs_peakGR,min(gs_engine.grL,gs_engine.grR));
gs_grL=max(-gs_engine.grL,gs_grL*gs_meter_decay);
gs_grR=max(-gs_engine.grR,gs_grR*gs_meter_decay);

@gfx 820 380
gs_draw_ui(gs_stereo);
