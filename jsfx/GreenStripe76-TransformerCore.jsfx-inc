// SPDX-License-Identifier: MIT — operation order mirrors src/dsp/Transformer.hpp.
import GreenStripe76-Transformers.jsfx-inc

@init
function gs_xf_cos(x) local(x2 y) (
  x2=x*x; y=1/6402373705728000;
  y=-1/20922789888000+x2*y; y=1/87178291200+x2*y;
  y=-1/479001600+x2*y; y=1/3628800+x2*y;
  y=-1/40320+x2*y; y=1/720+x2*y; y=-1/24+x2*y; y=0.5+x2*y;
  1-x2*y;
);
// 48 cells per prepared profile: model 0..20, derived 21..30, weights 32..45.
function gs_xf_prepare(rate which c) local(rb j w decay angle frequency co r mag den sum product) (
  gs_xf_model(which,c);
  c[21]=0.5/rate; c[22]=c[9]+c[10]; rb=c[11]+c[12];
  c[23]=1+c[22]/rb+c[22]*c[6]; c[24]=c[21]*6.283185307179586*c[5]; c[25]=0;
  j=0; loop(14,
    c[32+j]=c[13]*c[2]*gs_series_exp(c[3]*gs_series_log(gs_xf_stops[j]/0.001));
    c[25]+=c[32+j]*gs_xf_stops[j]; j+=1;
  );
  w=6.283185307179586*c[7]/rate;
  decay=gs_series_exp(-min(60,w/(2*c[8])));
  angle=w*sqrt(1-1/(4*c[8]*c[8]));
  angle-=6.283185307179586*floor(angle/6.283185307179586+0.5);
  c[26]=-2*decay*gs_xf_cos(angle); c[27]=decay*decay;
  frequency=min(20000,rate*0.4); co=gs_xf_cos(6.283185307179586*frequency/rate);
  r=frequency/c[7]; mag=1/((1-r*r)*(1-r*r)+r*r/(c[8]*c[8]));
  den=1+c[26]*c[26]+c[27]*c[27]+2*c[26]*(1+c[27])*co+2*c[27]*(2*co*co-1);
  sum=1+c[26]+c[27]; product=(sum*sum-mag*den)/(2*(1-co));
  c[28]=0.5*(sum+sqrt(max(0,sum*sum-4*product))); c[29]=sum-c[28];
  c[30]=c[12]/rb*c[20]/c[19];
);
function gs_xf_core_reset() instance(flux relax voltage stops x1 y1 y2 px2) (
  flux=relax=voltage=x1=y1=y2=px2=0; memset(stops,0,14);
);
function gs_xf_reset(which) instance(active requested blend) (
  this.gs_xf_core_reset(); active=requested=which; blend=which ? 1 : 0;
);
function gs_xf_init() instance(stops) (
  stops=gs_alloc(14); this.gs_xf_reset(0);
);
function gs_xf_law(x c) instance(slope) local(u knee fk sk target width delta e value d nonlinear j) (
  c[16]===0 ? (
    slope=1/c[0]; x/c[0];
  ) : c[14]===1 ? (
    u=abs(x)/c[1];
    u>0.98 ? (
      knee=0.98*c[1]; fk=knee*(1+c[16]*0.98/0.02)/c[0];
      sk=(1+c[16]*0.98/0.02+c[16]*0.98/(0.02*0.02))/c[0];
      target=1/(c[0]*c[17]); width=max(0.000001,c[1]*0.01); delta=abs(x)-knee;
      e=gs_series_exp(-min(60,delta/width)); slope=target+(sk-target)*e;
      value=fk+target*delta+(sk-target)*width*(1-e);
      x>=0 ? value : -value;
    ) : (
      d=1-u; slope=(1+c[16]*u/d+c[16]*u/(d*d))/c[0];
      x*(1+c[16]*u/d)/c[0];
    );
  ) : (
    u=abs(x)/c[1];
    nonlinear=1; loop(c[15]-1,nonlinear*=u;); nonlinear*=c[16];
    slope=(1+c[15]*nonlinear)/c[0]; x*(1+nonlinear)/c[0];
  );
);
function gs_xf_current(x c advance) instance(flux relax stops slope deriv)
local(value z j trial stop) (
  value=this.gs_xf_law(x,c); deriv=slope;
  z=((1-c[24])*relax+c[24]*(x+flux))/(1+c[24]);
  value+=(x-z)/c[4]; deriv+=1/((1+c[24])*c[4]);
  advance ? relax=gs_zap(z);
  c[13]!==0 ? (
    j=0; loop(14,
      trial=stops[j]+x-flux; stop=gs_bound(trial,-gs_xf_stops[j],gs_xf_stops[j]);
      value+=c[32+j]*stop;
      abs(trial)<gs_xf_stops[j] ? deriv+=c[32+j];
      advance ? stops[j]=gs_zap(stop); j+=1;
    );
  );
  value;
);
function gs_xf_core(input c) instance(flux relax voltage stops deriv x1 y1 y2 px2)
local(source rb bound lo hi x stop i residual next z j trial raw y) (
  source=input*c[19]; rb=abs((1-c[24])*relax+c[24]*flux)/((1+c[24])*c[4]);
  bound=abs(flux+c[21]*voltage)+c[21]*(abs(source)+c[22]*(c[25]+rb))/c[23]+0.000000000001;
  lo=-bound; hi=bound; x=gs_bound(flux+2*c[21]*voltage+(flux-px2),lo,hi); stop=0;
  loop(40,
    !stop ? (
      i=this.gs_xf_current(x,c,0);
      residual=x-flux-c[21]*(voltage+(source-c[22]*i)/c[23]);
      abs(residual)<=0.000001*(1+abs(x)) ? stop=1 : (
        residual>0 ? hi=x : lo=x;
        next=x-residual/(1+c[21]*c[22]*deriv/c[23]);
        x=next>lo && next<hi ? next : 0.5*(lo+hi);
      );
    );
  );
  stop ? (
    z=((1-c[24])*relax+c[24]*(x+flux))/(1+c[24]); relax=gs_zap(z);
    c[13]!==0 ? (
      j=0; loop(14,
        trial=stops[j]+x-flux;
        next=gs_bound(trial,-gs_xf_stops[j],gs_xf_stops[j]);
        stops[j]=gs_zap(next); j+=1;
      );
    );
  ) : (
    i=this.gs_xf_current(x,c,1);
  );
  px2=flux; flux=gs_zap(x); voltage=gs_zap((source-c[22]*i)/c[23]);
  raw=voltage*c[30]; y=c[28]*raw+c[29]*x1-c[26]*y1-c[27]*y2;
  x1=raw; y2=y1; y1=gs_zap(y); y;
);
function gs_xf_process(x selected bank rate) instance(active requested blend) local(step y) (
  !active && !selected ? x : (
  requested=selected; step=1/max(1,ceil(0.002*rate));
  active!==requested ? (
    blend=max(0,blend-step);
    blend<=0.000000000001 ? (blend=0; active=requested; this.gs_xf_core_reset(););
  ) : blend=min(active ? 1 : 0,blend+step);
  active ? (y=this.gs_xf_core(x,bank+(active-1)*48); x+blend*(y-x);) : x;
  );
);
