// SPDX-License-Identifier: MIT
// Original paired L/R meters; @gfx reads snapshots and never changes DSP state.
@init
function gs_meter_colour(db active) (
  db>-3 ? gfx_set(0.95,0.13,0.10,active ? 1 : 0.16) :
  db>-12 ? gfx_set(1.0,0.60,0.12,active ? 1 : 0.16) :
  db>-30 ? gfx_set(0.35,0.95,0.38,active ? 1 : 0.13) :
           gfx_set(0.035,0.38,0.13,active ? 1 : 0.24);
);
function gs_meter_y(db top height) ( top+height*(0-gs_bound(db,-60,0))/60; );

function gs_level_bar(x top width height peak rms hold clip)
local(db low high a b yy h marker) (
  gfx_set(0.018,0.029,0.019,1); gfx_rect(x-1,top-1,width+2,height+2);
  // Colour is determined by each scale region, not by recolouring the whole bar.
  db=-60;
  loop(30,
    low=db; high=db+2; a=gs_meter_y(high,top,height); b=gs_meter_y(low,top,height);
    gs_meter_colour((low+high)*0.5,0); gfx_rect(x,a,width,max(1,b-a-1));
    peak>low ? (
      a=gs_meter_y(min(high,peak),top,height);
      gs_meter_colour((low+high)*0.5,1); gfx_rect(x,a,width,max(0,b-a-1));
    );
    db+=2;
  );
  // RMS is a narrow pale line; hold takes the colour at the actual held level.
  rms>-60 ? (
    yy=gs_meter_y(rms,top,height); gfx_set(0.84,0.93,0.86,1); gfx_rect(x,yy,width,1);
  );
  hold>-60 ? (
    yy=gs_meter_y(hold,top,height); gs_meter_colour(hold,1); gfx_rect(x,yy,width,3);
  );
  gfx_set(clip>0 ? 1 : 0.22,clip>0 ? 0.10 : 0.035,clip>0 ? 0.06 : 0.026,1);
  gfx_rect(x,top-21,width,10);
  gfx_set(0.4,0.4,0.36,1); gfx_rect(x,top-21,width,10,0);
);

function gs_gr_bar(x top width height reduction) local(db a b) (
  gfx_set(0.035,0.055,0.040,1); gfx_rect(x-1,top-1,width+2,height+2);
  db=0;
  loop(15,
    a=top+height*db/30; b=top+height*(db+2)/30;
    gfx_set(0.22,0.15,0.035,1); gfx_rect(x,a,width,max(1,b-a-1));
    reduction>db ? (
      gfx_set(0.98,0.65,0.14,1);
      gfx_rect(x,a,width,max(0,height*(min(db+2,reduction)-db)/30-1));
    );
    db+=2;
  );
);

function gs_meter_group(x y width height label stereo gr peakL peakR rmsL rmsR holdL holdR clipL clipR)
local(top bh bw bx gap tick yy centre) (
  gfx_set(0.035,0.061,0.045,1); gfx_rect(x,y,width,height);
  gfx_set(0.24,0.36,0.28,1); gfx_rect(x,y,width,height,0);
  gfx_setfont(1,"Arial",13,'b'); gfx_set(0.85,0.94,0.86,1);
  gfx_x=x+12; gfx_y=y+8; gfx_drawstr(label);
  top=y+48; bh=max(50,height-95); gap=6;
  bw=min(76,(width-62-gap)/2); bx=x+43+(width-43-(stereo ? 2*bw+gap : bw))/2;
  !gr ? (
    // Held maximum peak, displayed once per group header above the bars.
    gfx_setfont(1,"Arial",11); gfx_set(0.98,0.65,0.14,1);
    stereo ? (gfx_x=x+width-126; gfx_printf("MAX %5.1f  %5.1f",gs_dispTopL,gs_dispTopR);)
            : (gfx_x=x+width-76; gfx_printf("MAX %5.1f",gs_dispTopL););
    gs_level_bar(bx,top,bw,bh,peakL,rmsL,holdL,clipL);
    stereo ? gs_level_bar(bx+bw+gap,top,bw,bh,peakR,rmsR,holdR,clipR);
  ) : (
    gs_gr_bar(bx,top,bw,bh,peakL);
    stereo ? gs_gr_bar(bx+bw+gap,top,bw,bh,peakR);
  );
  gfx_setfont(1,"Arial",11);
  tick=gr ? 0 : 0;
  loop(gr ? 7 : 16,
    yy=gr ? top+bh*tick/30 : gs_meter_y(-tick,top,bh);
    gfx_set(0.68,0.78,0.70,1); gfx_x=x+7; gfx_y=yy-5;
    gfx_printf("%d",tick);
    gfx_set(0.26,0.32,0.28,0.7); gfx_line(x+27,yy,bx-4,yy);
    tick+=gr ? 5 : 4;
  );
  gfx_setfont(1,"Arial",11); gfx_set(0.78,0.88,0.79,1);
  gfx_x=bx+bw/2-4; gfx_y=top+bh+6; gfx_drawstr(stereo ? "L" : "M");
  stereo ? (gfx_x=bx+bw+gap+bw/2-4; gfx_y=top+bh+6; gfx_drawstr("R"););
  gfx_setfont(1,"Arial",11); gfx_set(0.76,0.87,0.79,1);
  gfx_x=x+10; gfx_y=y+height-28;
  gr ? (
    stereo ? gfx_printf("GR L %5.1f   R %5.1f dB",-gs_dispNumL,-gs_dispNumR) : gfx_printf("GR %5.1f dB",-gs_dispNumL);
  ) : (
    stereo ? gfx_printf("RMS  %5.1f     %5.1f",gs_dispNumL,gs_dispNumR) : gfx_printf("RMS  %5.1f dBFS",gs_dispNumL);
  );
);

function gs_draw_ui(stereo)
local(w h now idle decay groupW groupH top inL inR outL outR inRmsL inRmsR
  rmsL rmsR inHoldL inHoldR holdL holdR inClipL inClipR clipL clipR grL grR activeOS linkText) (
  w=gfx_w; h=gfx_h; now=time_precise();
  idle=max(0,now-atomic_get(gs_audio_time)-0.1); decay=exp(-idle/0.35);
  // Fast snapshots feed the bars; the slow ~3 Hz snapshots feed every number.
  inL=atomic_get(gs_ui_inL)-idle*24; inR=atomic_get(gs_ui_inR)-idle*24;
  outL=atomic_get(gs_ui_outL)-idle*24; outR=atomic_get(gs_ui_outR)-idle*24;
  rmsL=atomic_get(gs_ui_rmsL)-idle*24; rmsR=atomic_get(gs_ui_rmsR)-idle*24;
  inRmsL=atomic_get(gs_ui_inRmsL)-idle*24; inRmsR=atomic_get(gs_ui_inRmsR)-idle*24;
  inHoldL=atomic_get(gs_ui_inHoldL)-max(0,idle-2.0)*24;
  inHoldR=atomic_get(gs_ui_inHoldR)-max(0,idle-2.0)*24;
  holdL=atomic_get(gs_ui_holdL)-max(0,idle-2.0)*24;
  holdR=atomic_get(gs_ui_holdR)-max(0,idle-2.0)*24;
  grL=atomic_get(gs_ui_grL)*decay; grR=atomic_get(gs_ui_grR)*decay;
  inClipL=idle>1 ? 0 : atomic_get(gs_ui_inClipL); inClipR=idle>1 ? 0 : atomic_get(gs_ui_inClipR);
  clipL=idle>1 ? 0 : atomic_get(gs_ui_clipL); clipR=idle>1 ? 0 : atomic_get(gs_ui_clipR);
  // Numeric display sampler: the numbers change at most ~3 times per second.
  // Display-only global state in @gfx; audio state is never touched here.
  now-gs_disp_t>=0.3 || idle>0.4 || gs_disp_t<=0 ? (
    gs_disp_t=now;
    gs_dinL=inL; gs_dinR=inR; gs_doutL=outL; gs_doutR=outR;
    gs_drmsL=rmsL; gs_drmsR=rmsR; gs_dinRmsL=inRmsL; gs_dinRmsR=inRmsR;
    gs_dinHoldL=inHoldL; gs_dinHoldR=inHoldR; gs_dholdL=holdL; gs_dholdR=holdR;
    gs_dgrL=grL; gs_dgrR=grR;
  );
  activeOS=atomic_get(gs_ui_os_active);
  linkText=stereo ? (slider10>0 ? "STEREO LINKED" : "STEREO / DUAL MONO") : "MONO";
  gfx_set(0.045,0.073,0.052,1); gfx_rect(0,0,w,h);
  h<235 || w<590 ? (
    gfx_setfont(1,"Arial",12); gfx_set(0.76,0.87,0.79,1); gfx_x=14; gfx_y=8;
    gfx_printf("IN  L %.1f  R %.1f dBFS",gs_dinL,gs_dinR);
    gfx_x=14; gfx_y=30; gfx_printf("GR  L %.1f  R %.1f dB",-gs_dgrL,-gs_dgrR);
    gfx_x=14; gfx_y=52; gfx_printf("OUT L %.1f  R %.1f dBFS",gs_doutL,gs_doutR);
    gfx_setfont(1,"Arial",12,'b'); gfx_set(0.93,0.99,0.94,1); gfx_x=14; gfx_y=74;
    gfx_printf("GREEN STRIPE 76 - %s",linkText);
    gfx_setfont(1,"Arial",12); gfx_set(0.76,0.87,0.79,1); gfx_x=14; gfx_y=94;
    gfx_printf("OS %s",activeOS===0 ? "OFF" : activeOS===1 ? "2x" : "4x");
    gfx_printf("Input %+.1f dB   Output %+.1f dB   Attack %.2f   Release %.2f",slider1,slider2,slider3,slider4);
    gfx_x=14; gfx_y=114;
    gfx_printf("Ratio %s   Mix %.0f%%   Colour %.0f%%   %s",slider5==4 ? "ALL" : slider5==3 ? "20:1" : slider5==2 ? "12:1" : slider5==1 ? "8:1" : "4:1",slider6,slider7,slider8>0 ? "COMP ON" : "COLOUR ONLY");
  ) : (
    groupW=(w-48)/3; groupH=h-80; top=8;
    gs_dispTopL=gs_dinHoldL; gs_dispTopR=gs_dinHoldR; gs_dispNumL=gs_dinRmsL; gs_dispNumR=gs_dinRmsR;
    gs_meter_group(12,top,groupW,groupH,"INPUT",stereo,0,inL,inR,inRmsL,inRmsR,inHoldL,inHoldR,inClipL,inClipR);
    gs_dispTopL=0; gs_dispTopR=0; gs_dispNumL=gs_dgrL; gs_dispNumR=gs_dgrR;
    gs_meter_group(24+groupW,top,groupW,groupH,"GAIN REDUCTION",stereo,1,grL,grR,0,0,0,0,0,0);
    gs_dispTopL=gs_dholdL; gs_dispTopR=gs_dholdR; gs_dispNumL=gs_drmsL; gs_dispNumR=gs_drmsR;
    gs_meter_group(36+2*groupW,top,groupW,groupH,"OUTPUT",stereo,0,outL,outR,rmsL,rmsR,holdL,holdR,clipL,clipR);
    gfx_setfont(1,"Arial",12,'b'); gfx_set(0.93,0.99,0.94,1); gfx_x=14; gfx_y=h-64;
    gfx_printf("GREEN STRIPE 76 - %s",linkText);
    gfx_setfont(1,"Arial",12); gfx_set(0.76,0.87,0.79,1); gfx_x=max(300,w-120); gfx_y=h-64;
    gfx_printf("OS %s",activeOS===0 ? "OFF" : activeOS===1 ? "2x" : "4x");
    gfx_x=14; gfx_y=h-44;
    gfx_printf("Input %+.1f dB   Output %+.1f dB   Attack %.2f   Release %.2f",slider1,slider2,slider3,slider4);
    gfx_x=14; gfx_y=h-24;
    gfx_printf("Ratio %s   Mix %.0f%%   Colour %.0f%%   %s",slider5==4 ? "ALL" : slider5==3 ? "20:1" : slider5==2 ? "12:1" : slider5==1 ? "8:1" : "4:1",slider6,slider7,slider8>0 ? "COMP ON" : "COLOUR ONLY");
  );
);
