@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix mod: <http://moddevices.com/ns/mod#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .

<https://github.com/j4yj03/mod-1175-lv2#green-stripe-76-mono> modgui:gui [
    modgui:resourcesDirectory <modgui>;
    modgui:iconTemplate <modgui/icon-mono.html>;
    modgui:stylesheet <modgui/green-stripe.css>;
    modgui:screenshot <modgui/screenshot-mono.png>;
    modgui:thumbnail <modgui/thumbnail-mono.png>;
    modgui:port
    [ lv2:index 0; lv2:symbol "input"; lv2:name "Input" ],
    [ lv2:index 1; lv2:symbol "output"; lv2:name "Output" ],
    [ lv2:index 2; lv2:symbol "attack"; lv2:name "Attack" ],
    [ lv2:index 3; lv2:symbol "release"; lv2:name "Release" ],
    [ lv2:index 4; lv2:symbol "ratio"; lv2:name "Ratio" ],
    [ lv2:index 5; lv2:symbol "mix"; lv2:name "Mix" ],
    [ lv2:index 6; lv2:symbol "colour"; lv2:name "Colour" ],
    [ lv2:index 7; lv2:symbol "compression"; lv2:name "Compression" ],
    [ lv2:index 8; lv2:symbol "oversampling"; lv2:name "Oversampling" ] ] .

<https://github.com/j4yj03/mod-1175-lv2#green-stripe-76-stereo> modgui:gui [
    modgui:resourcesDirectory <modgui>;
    modgui:iconTemplate <modgui/icon-stereo.html>;
    modgui:stylesheet <modgui/green-stripe.css>;
    modgui:screenshot <modgui/screenshot-stereo.png>;
    modgui:thumbnail <modgui/thumbnail-stereo.png>;
    modgui:port
    [ lv2:index 0; lv2:symbol "input"; lv2:name "Input" ],
    [ lv2:index 1; lv2:symbol "output"; lv2:name "Output" ],
    [ lv2:index 2; lv2:symbol "attack"; lv2:name "Attack" ],
    [ lv2:index 3; lv2:symbol "release"; lv2:name "Release" ],
    [ lv2:index 4; lv2:symbol "ratio"; lv2:name "Ratio" ],
    [ lv2:index 5; lv2:symbol "mix"; lv2:name "Mix" ],
    [ lv2:index 6; lv2:symbol "colour"; lv2:name "Colour" ],
    [ lv2:index 7; lv2:symbol "compression"; lv2:name "Compression" ],
    [ lv2:index 8; lv2:symbol "stereo_link"; lv2:name "Stereo Link" ],
    [ lv2:index 9; lv2:symbol "oversampling"; lv2:name "Oversampling" ] ] .

