@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix mod: <http://moddevices.com/ns/mod#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .

<https://github.com/j4yj03/mod-1175-lv2#green-stripe-76-mono> a lv2:Plugin, lv2:CompressorPlugin;
    doap:name "Green Stripe 76 Mono";
    doap:license <https://opensource.org/license/mit>;
    doap:maintainer [ foaf:name "Green Stripe 76 contributors";
        foaf:homepage <https://github.com/j4yj03/mod-1175-lv2> ];
    mod:brand "GreenStripe"; mod:label "GS76 Mono";
    lv2:minorVersion 5; lv2:microVersion 2;
    lv2:optionalFeature lv2:hardRTCapable;
    rdfs:comment "Independent FET feedback adaptation. Selectable Off/2x/4x oversampling, default Off, programme-dependent recovery, All Buttons, amplifier colour and refit-able input transformer profiles. No lookahead or brickwall guarantee. Nominal IIR latency is frequency dependent. Input/Output are digital dB gains. See project documentation.";
    lv2:port
    [ a lv2:InputPort, lv2:AudioPort; lv2:index 0; lv2:symbol "in"; lv2:name "Input" ],
    [ a lv2:OutputPort, lv2:AudioPort; lv2:index 1; lv2:symbol "out"; lv2:name "Output" ],
    [ a lv2:InputPort, lv2:ControlPort; lv2:index 2;
      lv2:symbol "input"; lv2:name "Input";
      lv2:shortName "Input"; lv2:default 0;
      lv2:minimum -36; lv2:maximum 24;
      units:unit units:db;
      pprops:rangeSteps 601 ],
    [ a lv2:InputPort, lv2:ControlPort; lv2:index 3;
      lv2:symbol "output"; lv2:name "Output";
      lv2:shortName "Output"; lv2:default 0;
      lv2:minimum -36; lv2:maximum 24;
      units:unit units:db;
      pprops:rangeSteps 601 ],
    [ a lv2:InputPort, lv2:ControlPort; lv2:index 4;
      lv2:symbol "attack"; lv2:name "Attack";
      lv2:shortName "Attack"; lv2:default 3;
      lv2:minimum 1; lv2:maximum 7;
      pprops:rangeSteps 601 ],
    [ a lv2:InputPort, lv2:ControlPort; lv2:index 5;
      lv2:symbol "release"; lv2:name "Release";
      lv2:shortName "Release"; lv2:default 5;
      lv2:minimum 1; lv2:maximum 7;
      pprops:rangeSteps 601 ],
    [ a lv2:InputPort, lv2:ControlPort; lv2:index 6;
      lv2:symbol "ratio"; lv2:name "Ratio";
      lv2:shortName "Ratio"; lv2:default 1;
      lv2:minimum 0; lv2:maximum 5;
      lv2:portProperty lv2:integer, lv2:enumeration;
      lv2:scalePoint [ rdfs:label "2:1"; rdf:value 0 ];
      lv2:scalePoint [ rdfs:label "4:1"; rdf:value 1 ];
      lv2:scalePoint [ rdfs:label "8:1"; rdf:value 2 ];
      lv2:scalePoint [ rdfs:label "12:1"; rdf:value 3 ];
      lv2:scalePoint [ rdfs:label "20:1"; rdf:value 4 ];
      lv2:scalePoint [ rdfs:label "All Buttons"; rdf:value 5 ];
      pprops:rangeSteps 6 ],
    [ a lv2:InputPort, lv2:ControlPort; lv2:index 7;
      lv2:symbol "mix"; lv2:name "Mix";
      lv2:shortName "Mix"; lv2:default 100;
      lv2:minimum 0; lv2:maximum 100;
      units:unit units:pc;
      pprops:rangeSteps 601 ],
    [ a lv2:InputPort, lv2:ControlPort; lv2:index 8;
      lv2:symbol "colour"; lv2:name "Colour";
      lv2:shortName "Colour"; lv2:default 100;
      lv2:minimum 0; lv2:maximum 100;
      units:unit units:pc;
      pprops:rangeSteps 601 ],
    [ a lv2:InputPort, lv2:ControlPort; lv2:index 9;
      lv2:symbol "compression"; lv2:name "Compression";
      lv2:shortName "Comp"; lv2:default 1;
      lv2:minimum 0; lv2:maximum 1;
      lv2:portProperty lv2:integer, lv2:enumeration;
      lv2:scalePoint [ rdfs:label "COMP OFF"; rdf:value 0 ];
      lv2:scalePoint [ rdfs:label "COMP ON"; rdf:value 1 ];
      pprops:rangeSteps 2 ],
    [ a lv2:InputPort, lv2:ControlPort; lv2:index 10;
      lv2:symbol "enabled"; lv2:name "Enabled";
      lv2:shortName "Enabled"; lv2:default 1;
      lv2:minimum 0; lv2:maximum 1;
      lv2:designation lv2:enabled;
      lv2:portProperty lv2:integer, lv2:toggled;
      pprops:rangeSteps 2 ],
    [ a lv2:OutputPort, lv2:ControlPort; lv2:index 11; lv2:symbol "latency"; lv2:name "Nominal latency"; lv2:designation lv2:latency; lv2:portProperty lv2:integer, pprops:notOnGUI; units:unit units:frame; lv2:minimum 0; lv2:maximum 32; lv2:default 0 ],
    [ a lv2:InputPort, lv2:ControlPort; lv2:index 12;
      lv2:symbol "oversampling"; lv2:name "Oversampling";
      lv2:shortName "OS"; lv2:default 0;
      lv2:minimum 0; lv2:maximum 2;
      lv2:portProperty lv2:integer, lv2:enumeration, lv2:connectionOptional;
      lv2:scalePoint [ rdfs:label "Off"; rdf:value 0 ];
      lv2:scalePoint [ rdfs:label "2x"; rdf:value 1 ];
      lv2:scalePoint [ rdfs:label "4x"; rdf:value 2 ];
      pprops:rangeSteps 3 ],
    [ a lv2:InputPort, lv2:ControlPort; lv2:index 13;
      lv2:symbol "transformer"; lv2:name "Transformer";
      lv2:shortName "Xfm"; lv2:default 0;
      lv2:minimum 0; lv2:maximum 4;
      lv2:portProperty lv2:integer, lv2:enumeration, lv2:connectionOptional;
      lv2:scalePoint [ rdfs:label "None"; rdf:value 0 ];
      lv2:scalePoint [ rdfs:label "60s"; rdf:value 1 ];
      lv2:scalePoint [ rdfs:label "80s"; rdf:value 2 ];
      lv2:scalePoint [ rdfs:label "00s"; rdf:value 3 ];
      lv2:scalePoint [ rdfs:label "Symmetric"; rdf:value 4 ];
      pprops:rangeSteps 5 ],
    [ a lv2:OutputPort, lv2:ControlPort; lv2:index 14;
      lv2:symbol "gr_db"; lv2:name "Gain Reduction";
      lv2:shortName "GR"; lv2:default 0;
      lv2:minimum -60; lv2:maximum 0;
      units:unit units:db;
      lv2:portProperty lv2:connectionOptional;
      pprops:rangeSteps 601 ] .
